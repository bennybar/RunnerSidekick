# Runner Sidekick server settings for docker compose. Copy to .env and edit; every line is optional.

# Time zone for users who haven't set their own in the app (IANA name, e.g. Europe/London)
RSK_TIMEZONE=UTC

# The server's public https address, e.g. https://api.example.com. Only Garmin's official OAuth (developer
# program, configured in secrets.json) needs it; leave empty otherwise.
RSK_PUBLIC_BASE_URL=

# OpenAI key for AI summaries on the server. Empty: no server AI (runners can still add their own key in the app).
OPENAI_API_KEY=

# Google sign-in uses the app's public client IDs by default and is invite-only (`sidekick invite add EMAIL`).
# Set this to an empty value to switch Google sign-in off entirely; device tokens always work.
# RSK_GOOGLE_WEB_CLIENT_ID=
# RSK_GOOGLE_IOS_CLIENT_ID=

# Sync tuning (defaults shown)
# RSK_BACKFILL_DAYS=90
# RSK_REFETCH_DAYS=3
# RSK_RAW_RETENTION_DAYS=120
# RSK_AI_MAX_CALLS_PER_DAY=25
